#!/usr/bin/env bash

# print the usage for the dp function
__dot_dp_usage() {
    cat <<EOF
dp ~ change to a different prompt

dp [-h] [NUM]
  -h, --help    show this help menu
  num           the prompt index

Available prompts:
  default: full prompt with face
  1: minimalist
  2: date only
  3: date and pwd
  4: mood based on last command
  5: comment box
EOF
}

# change to a different prompt (different PS1 variables)
dp() {
    if [[ $# -eq 0 ]]; then
        # default
        export __PS1__=''
    elif [[ $1 == -h || $1 == --help ]]; then
        __dot_dp_usage
        return 0
    elif [[ $1 == 1 ]]; then
        # minimalist
        export __PS1__="\\$ "
    elif [[ $1 == 2 ]]; then
        # just date
        export __PS1__="[\A] > "
    elif [[ $1 == 3 ]]; then
        # full date and pwd
        export __PS1__="[\u@\h] \d, \T <\W> \\$ "
    elif [[ $1 == 4 ]]; then
        # mood based on last command
        export __PS1__="\`if [ \$? = 0 ]; then echo \[\e[33m\]^_^\[\e[0m\]; else echo \[\e[31m\]O_O\[\e[0m\]; fi\` \\$ "
    elif [[ $1 == 5 ]]; then
        export __PS1__=":; "
    else
        printf 'dp: err: invalid prompt index, must be [1,5]\n' >&2
        return 1
    fi
}
