#!/usr/bin/env bash

# print the usage for the face function
__dot_face_usage() {
    cat <<EOF
face ~ change the prompt face

face [-h] [-l] [NUM]
  -h, --help    show this help menu
  -l, --list    list faces
  num           the face index

Available faces:
  1: ༼つ•_•༽つ
  2: ʕっ•ᴥ•ʔっ (default)
  3: ฅ^•ﻌ•^ฅ
EOF
}

# print one face by index
__dot_face_at() {
    case $1 in
        1) printf '%s\n' '༼つ•_•༽つ' ;;
        2) printf '%s\n' 'ʕっ•ᴥ•ʔっ' ;;
        3) printf '%s\n' 'ฅ^•ﻌ•^ฅ' ;;
        *) return 1 ;;
    esac
}

# change the prompt face
face() {
    local current n i face mark

    if [[ $# -eq 0 ]] ; then
        current=${DOT_PROMPT_FACE:-}
        n=1
        i=1
        while [[ $i -le 3 ]] ; do
            face=$(__dot_face_at "$i")
            if [[ "$face" == "$current" ]] ; then
                n=$((i + 1))
                if [[ $n -gt 3 ]] ; then
                    n=1
                fi
                break
            fi
            i=$((i + 1))
        done
        DOT_PROMPT_FACE=$(__dot_face_at "$n")
    elif [[ "$1" == "-h" || "$1" == "--help" ]] ; then
        __dot_face_usage
        return 0
    elif [[ "$1" == "-l" || "$1" == "--list" ]] ; then
        if [[ $# -ne 1 ]] ; then
            >&2 echo "face: err: invalid face index, must be [1,3]"
            return 1
        fi
        current=${DOT_PROMPT_FACE:-}
        i=1
        while [[ $i -le 3 ]] ; do
            face=$(__dot_face_at "$i")
            if [[ "$face" == "$current" ]] ; then
                mark='* '
            else
                mark='  '
            fi
            printf '%s%s. %s\n' "$mark" "$i" "$face"
            i=$((i + 1))
        done
    elif [[ "$1" == "1" || "$1" == "2" || "$1" == "3" ]] ; then
        if [[ $# -ne 1 ]] ; then
            >&2 echo "face: err: invalid face index, must be [1,3]"
            return 1
        fi
        DOT_PROMPT_FACE=$(__dot_face_at "$1")
    else
        >&2 echo "face: err: invalid face index, must be [1,3]"
        return 1
    fi
}
