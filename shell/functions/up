#!/usr/bin/env bash

# print the usage for the up function
__dot_up_usage() {
    cat <<EOF
up ~ go up a directory

up [-h] [NUM]
  -h, --help    show this menu and exit
  num           the number of directories to go up (default: 1)
EOF
}

# go up a directory
up() {
    if [[ ${1-} == -h || ${1-} == --help ]]; then
        __dot_up_usage
        return 0
    fi

    if (( $# > 1 )); then
        printf 'up: err: incorrect number of arguments\n' >&2
        return 1
    fi

    local levels=1
    if (( $# == 1 )); then
        if [[ ! $1 =~ ^[0-9]+$ ]]; then
            printf 'up: err: argument must be a number\n' >&2
            return 1
        fi
        if ! levels=$((10#$1)) 2>/dev/null; then
            printf 'up: err: argument must be a positive integer\n' >&2
            return 1
        fi
        if (( levels < 1 )); then
            printf 'up: err: argument must be a positive integer\n' >&2
            return 1
        fi
    fi

    # keep the original directory while we are still on the way back to it
    # match on a slash boundary so '.../dir' is not treated as '.../dir-extra'
    if [[ -z ${__UPDIR__-} ]]; then
        __UPDIR__=$PWD
    elif [[ $PWD == / ]]; then
        :
    else
        case $__UPDIR__ in
            "$PWD"|"$PWD"/*) ;;
            *) __UPDIR__=$PWD ;;
        esac
    fi
    export -n __UPDIR__

    local dest=$PWD
    local i
    for ((i = 0; i < levels; i++)); do
        if [[ $dest == / ]]; then
            break
        fi
        dest=${dest%/*}
        [[ -n $dest ]] || dest=/
    done

    if ! cd -- "$dest" 2>/dev/null; then
        printf 'up: err: cannot change directory\n' >&2
        return 1
    fi
    printf '%s\n' "$PWD"
}
